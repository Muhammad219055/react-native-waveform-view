{
  "name": "react-native-waveform-view",
  "version": "0.1.0-beta.1",
  "description": "React Native audio waveform view: a scrolling waveform scrubber with native waveform data extraction on Android and iOS. Seek and scrub long audio with any player.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-waveform-view.podspec",
    "!android/build",
    "!android/.gradle",
    "!ios/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "bob build",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "react native",
    "audio",
    "waveform",
    "audio-waveform",
    "react-native-waveform",
    "waveform-view",
    "audio-visualizer",
    "visualizer",
    "scrubber",
    "seek",
    "seekbar",
    "scrubbing",
    "audio-player",
    "music-player",
    "voice-note",
    "voice-memo",
    "podcast",
    "transcript",
    "waveform-generator",
    "amplitude",
    "pcm",
    "decibel",
    "loudness",
    "android",
    "ios",
    "reanimated",
    "gesture-handler",
    "svg",
    "waveform-scrubber",
    "audio-scrubber"
  ],
  "license": "MIT",
  "author": "Solutions Loft <muhammad.arshad@solutionsloft.com>",
  "homepage": "https://github.com/MuhammadArshad-dev/rn-waveform#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuhammadArshad-dev/rn-waveform.git"
  },
  "bugs": {
    "url": "https://github.com/MuhammadArshad-dev/rn-waveform/issues"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@react-native/babel-preset": "^0.76.5",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-builder-bob": "^0.40.0",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-reanimated": "^3.16.1",
    "react-native-svg": "^15.8.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
